# Dukaan Marketplace Environment Configuration
# Copy this file to .env and populate with genuine production credentials.
# WARNING: NEVER commit .env to version control or expose it publicly!

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (Production requires a secured MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/dukaan-market

# JWT Secret (Must be unique, cryptographically random, >= 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-32-plus-char-random-secret

# Razorpay Payments (UPI, Cards, Netbanking)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret

# AI Price Verification APIs & Quotas
GEMINI_API_KEY=
GEMINI_PRICE_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_PRICE_MODEL=google/gemini-2.5-flash
DAILY_AI_BUDGET=100


# Optional local-only demo accounts (do not set in production)
DEV_DEMO_CUSTOMER_EMAIL=
DEV_DEMO_CUSTOMER_PASSWORD=
DEV_DEMO_ADMIN_EMAIL=
DEV_DEMO_ADMIN_PASSWORD=
